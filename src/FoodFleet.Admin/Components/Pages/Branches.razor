@page "/branches"
@rendermode InteractiveServer
@attribute [Authorize]
@inject AdminApiClient Api

<PageTitle>Branches – FoodFleet Admin</PageTitle>

<!-- Header -->
<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-xl font-bold text-slate-800">Branches</h1>
        <p class="text-sm text-slate-500 mt-0.5">Manage your restaurant locations</p>
    </div>
    <button class="inline-flex items-center gap-2 bg-brand hover:bg-brand-dark text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors shadow-sm" @onclick="OpenCreate">
        <i class="fa-solid fa-plus text-xs"></i> New Branch
    </button>
</div>

@if (_loading)
{
    <div class="flex items-center justify-center h-64">
        <svg class="animate-spin h-8 w-8 text-brand" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
    </div>
}
else if (!string.IsNullOrEmpty(_error))
{
    <div class="flex items-center gap-2.5 bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-xl mb-4">
        <i class="fa-solid fa-circle-exclamation"></i><span>@_error</span>
    </div>
}
else
{
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-100">
                        <th class="text-left text-xs font-semibold text-slate-500 uppercase tracking-wide px-5 py-3">Name</th>
                        <th class="text-left text-xs font-semibold text-slate-500 uppercase tracking-wide px-5 py-3">City</th>
                        <th class="text-left text-xs font-semibold text-slate-500 uppercase tracking-wide px-5 py-3">Phone</th>
                        <th class="text-left text-xs font-semibold text-slate-500 uppercase tracking-wide px-5 py-3">Status</th>
                        <th class="text-left text-xs font-semibold text-slate-500 uppercase tracking-wide px-5 py-3">Hours</th>
                        <th class="text-right text-xs font-semibold text-slate-500 uppercase tracking-wide px-5 py-3">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    @if (_branches.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-slate-400 py-12">
                            <i class="fa-solid fa-store text-3xl block mb-2"></i>No branches yet.
                        </td></tr>
                    }
                    @foreach (var b in _branches)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-5 py-3.5 font-semibold text-slate-700">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-7 h-7 bg-brand/10 rounded-lg flex items-center justify-center">
                                        <i class="fa-solid fa-store text-brand text-xs"></i>
                                    </div>
                                    @b.Name
                                </div>
                            </td>
                            <td class="px-5 py-3.5 text-slate-500">
                                <i class="fa-solid fa-location-dot text-slate-300 mr-1.5 text-xs"></i>@b.City
                            </td>
                            <td class="px-5 py-3.5 text-slate-500">@b.PhoneNumber</td>
                            <td class="px-5 py-3.5">
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium @(b.IsActive ? "bg-emerald-100 text-emerald-700" : "bg-slate-100 text-slate-500")">
                                    <span class="w-1.5 h-1.5 rounded-full @(b.IsActive ? "bg-emerald-500" : "bg-slate-400")"></span>
                                    @(b.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="px-5 py-3.5 text-slate-500 text-xs">
                                <i class="fa-regular fa-clock mr-1"></i>@b.OpeningTime – @b.ClosingTime
                            </td>
                            <td class="px-5 py-3.5 text-right">
                                <button class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-600 hover:text-brand border border-slate-200 hover:border-brand/30 px-3 py-1.5 rounded-lg transition-colors mr-1.5" @onclick="() => OpenEdit(b)">
                                    <i class="fa-solid fa-pen text-xs"></i> Edit
                                </button>
                                <button class="inline-flex items-center gap-1.5 text-xs font-medium text-red-500 hover:text-red-700 border border-red-100 hover:border-red-300 px-3 py-1.5 rounded-lg transition-colors" @onclick="() => ConfirmDelete(b)">
                                    <i class="fa-solid fa-trash text-xs"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (_showModal)
{
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4" @onclick="CloseModal">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl" @onclick:stopPropagation="true">
            <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
                <h2 class="text-base font-semibold text-slate-800">
                    <i class="fa-solid fa-store text-brand mr-2"></i>@(_editId == null ? "New Branch" : "Edit Branch")
                </h2>
                <button class="w-7 h-7 flex items-center justify-center rounded-full hover:bg-slate-100 text-slate-400 hover:text-slate-600 transition-colors" @onclick="CloseModal">
                    <i class="fa-solid fa-xmark text-sm"></i>
                </button>
            </div>
            <div class="px-6 py-5">
                @if (!string.IsNullOrEmpty(_modalError))
                {
                    <div class="flex items-center gap-2 bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-2.5 rounded-xl mb-4">
                        <i class="fa-solid fa-circle-exclamation"></i><span>@_modalError</span>
                    </div>
                }
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5">Name *</label>
                        <input class="w-full text-sm border border-slate-300 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand" @bind="_form.Name" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5">Phone Number</label>
                        <input class="w-full text-sm border border-slate-300 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand" @bind="_form.PhoneNumber" />
                    </div>
                    <div class="col-span-2">
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5">Address *</label>
                        <input class="w-full text-sm border border-slate-300 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand" @bind="_form.Address" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5">City *</label>
                        <input class="w-full text-sm border border-slate-300 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand" @bind="_form.City" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5">Delivery Radius (km)</label>
                        <input type="number" step="0.1" class="w-full text-sm border border-slate-300 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand" @bind="_form.DeliveryRadiusKm" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5">Latitude</label>
                        <input type="number" step="any" class="w-full text-sm border border-slate-300 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand" @bind="_form.Latitude" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5">Longitude</label>
                        <input type="number" step="any" class="w-full text-sm border border-slate-300 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand" @bind="_form.Longitude" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5">Opening Time</label>
                        <input class="w-full text-sm border border-slate-300 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand" @bind="_form.OpeningTime" placeholder="09:00" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5">Closing Time</label>
                        <input class="w-full text-sm border border-slate-300 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand" @bind="_form.ClosingTime" placeholder="22:00" />
                    </div>
                    <div class="col-span-2 flex items-center gap-2.5 pt-1">
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" class="sr-only peer" @bind="_form.IsActive" />
                            <div class="w-10 h-5 bg-slate-200 peer-checked:bg-brand rounded-full transition-colors"></div>
                            <div class="absolute left-0.5 top-0.5 bg-white w-4 h-4 rounded-full shadow transition-transform peer-checked:translate-x-5"></div>
                        </label>
                        <span class="text-sm font-medium text-slate-700">Branch is active</span>
                    </div>
                </div>
            </div>
            <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-slate-100 bg-slate-50 rounded-b-2xl">
                <button class="text-sm font-medium text-slate-600 hover:text-slate-800 px-4 py-2 rounded-xl hover:bg-slate-200 transition-colors" @onclick="CloseModal">Cancel</button>
                <button class="inline-flex items-center gap-2 bg-brand hover:bg-brand-dark text-white text-sm font-semibold px-5 py-2 rounded-xl transition-colors disabled:opacity-60" @onclick="SaveBranch" disabled="@_saving">
                    @if (_saving)
                    {
                        <svg class="animate-spin h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                    }
                    Save Branch
                </button>
            </div>
        </div>
    </div>
}

@if (_deleteTarget is not null)
{
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md">
            <div class="px-6 pt-6 pb-4 text-center">
                <div class="w-14 h-14 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fa-solid fa-trash text-red-500 text-xl"></i>
                </div>
                <h3 class="text-base font-semibold text-slate-800 mb-1">Delete Branch?</h3>
                <p class="text-sm text-slate-500">Are you sure you want to delete <span class="font-semibold text-slate-700">@_deleteTarget.Name</span>? This action cannot be undone.</p>
            </div>
            <div class="flex items-center justify-center gap-3 px-6 py-4 border-t border-slate-100">
                <button class="text-sm font-medium text-slate-600 hover:text-slate-800 px-5 py-2 rounded-xl border border-slate-200 hover:bg-slate-50 transition-colors" @onclick="() => _deleteTarget = null">Cancel</button>
                <button class="text-sm font-semibold text-white bg-red-500 hover:bg-red-600 px-5 py-2 rounded-xl transition-colors" @onclick="DeleteBranch">Delete</button>
            </div>
        </div>
    </div>
}


@code {
    private List<BranchDto> _branches = new();
    private bool _loading = true;
    private string _error = string.Empty;
    private bool _showModal;
    private bool _saving;
    private string _modalError = string.Empty;
    private Guid? _editId;
    private BranchFormModel _form = new();
    private BranchDto? _deleteTarget;

    protected override async Task OnInitializedAsync() => await LoadBranches();

    private async Task LoadBranches()
    {
        _loading = true;
        var r = await Api.GetBranchesAsync();
        if (r.IsSuccess) _branches = r.Data ?? new();
        else _error = r.Error ?? "Failed to load branches.";
        _loading = false;
    }

    private void OpenCreate()
    {
        _editId = null;
        _form = new();
        _modalError = string.Empty;
        _showModal = true;
    }

    private void OpenEdit(BranchDto b)
    {
        _editId = b.Id;
        _form = new BranchFormModel
        {
            Name = b.Name, Address = b.Address, City = b.City,
            PhoneNumber = b.PhoneNumber, Latitude = b.Latitude,
            Longitude = b.Longitude, OpeningTime = b.OpeningTime,
            ClosingTime = b.ClosingTime, DeliveryRadiusKm = b.DeliveryRadiusKm,
            IsActive = b.IsActive
        };
        _modalError = string.Empty;
        _showModal = true;
    }

    private void CloseModal() => _showModal = false;

    private async Task SaveBranch()
    {
        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            _modalError = "Name is required.";
            return;
        }
        _saving = true;
        _modalError = string.Empty;

        ApiResult<BranchDto> r;
        if (_editId is null)
        {
            r = await Api.CreateBranchAsync(new CreateBranchRequest(
                _form.Name, _form.Address, _form.City, _form.PhoneNumber,
                _form.Latitude, _form.Longitude, _form.OpeningTime,
                _form.ClosingTime, _form.DeliveryRadiusKm));
        }
        else
        {
            r = await Api.UpdateBranchAsync(_editId.Value, new UpdateBranchRequest(
                _form.Name, _form.Address, _form.City, _form.PhoneNumber,
                _form.Latitude, _form.Longitude, _form.OpeningTime,
                _form.ClosingTime, _form.DeliveryRadiusKm, _form.IsActive));
        }

        if (r.IsSuccess)
        {
            _showModal = false;
            await LoadBranches();
        }
        else
        {
            _modalError = r.Error ?? "Save failed.";
        }
        _saving = false;
    }

    private void ConfirmDelete(BranchDto b) => _deleteTarget = b;

    private async Task DeleteBranch()
    {
        if (_deleteTarget is null) return;
        var r = await Api.DeleteBranchAsync(_deleteTarget.Id);
        _deleteTarget = null;
        if (r.IsSuccess) await LoadBranches();
        else _error = r.Error ?? "Delete failed.";
    }

    private class BranchFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
        public string City { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public string OpeningTime { get; set; } = "09:00";
        public string ClosingTime { get; set; } = "22:00";
        public double DeliveryRadiusKm { get; set; } = 5.0;
        public bool IsActive { get; set; } = true;
    }
}
