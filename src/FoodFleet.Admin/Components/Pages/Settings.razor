@page "/settings"
@attribute [Authorize]
@inject AdminApiClient Api

<PageTitle>Settings – FoodFleet Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Settings</h3>
    <button class="btn btn-primary" @onclick="SaveAll" disabled="@_saving">
        @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
        Save All
    </button>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success">@_success</div>
}

@if (_loading)
{
    <div class="d-flex justify-content-center mt-4"><div class="spinner-border text-primary"></div></div>
}
else if (_settings.Count == 0)
{
    <p class="text-muted text-center mt-3">No settings configured yet.</p>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            @foreach (var group in _grouped.Keys)
            {
                <h5 class="text-muted text-uppercase small fw-bold mt-3 mb-2">@group</h5>
                @foreach (var s in _grouped[group])
                {
                    <div class="row mb-3 align-items-center">
                        <div class="col-md-4">
                            <label class="form-label mb-0 fw-semibold" title="@s.Key">@FormatKey(s.Key)</label>
                        </div>
                        <div class="col-md-5">
                            @if (IsBoolKey(s.Key))
                            {
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox"
                                           checked="@(s.Value == "true")"
                                           @onchange="e => OnBoolToggle(s, e)" />
                                </div>
                            }
                            else
                            {
                                <input class="form-control" value="@s.Value"
                                       @onchange="e => s.Value = e.Value?.ToString() ?? string.Empty" />
                            }
                        </div>
                    </div>
                }
                <hr />
            }
        </div>
    </div>
}

@code {
    private List<SettingDto> _settings = new();
    private Dictionary<string, List<SettingDto>> _grouped = new();
    private bool _loading = true;
    private bool _saving;
    private string _error = string.Empty;
    private string _success = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var r = await Api.GetSettingsAsync();
        if (r.IsSuccess)
        {
            _settings = r.Data ?? new();
            BuildGroups();
        }
        else _error = r.Error ?? "Failed to load settings.";
        _loading = false;
    }

    private void BuildGroups()
    {
        _grouped = _settings
            .GroupBy(s => s.Key.Contains('.') ? s.Key.Split('.')[0].ToUpper() : "GENERAL")
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private async Task SaveAll()
    {
        _saving = true; _error = string.Empty; _success = string.Empty;
        var updates = _settings.Select(s => new SettingUpsertItem(s.Key, s.Value)).ToList();
        var r = await Api.BulkUpsertSettingsAsync(updates);
        _saving = false;
        if (r.IsSuccess) _success = "Settings saved successfully.";
        else _error = r.Error ?? "Failed to save settings.";
    }

    private static bool IsBoolKey(string key) =>
        key.Contains("enabled", StringComparison.OrdinalIgnoreCase) ||
        key.Contains("active", StringComparison.OrdinalIgnoreCase);

    private static void OnBoolToggle(SettingDto s, ChangeEventArgs e)
        => s.Value = ((bool)(e.Value ?? false)) ? "true" : "false";

    private static string FormatKey(string key)
    {
        var part = key.Contains('.') ? key[(key.LastIndexOf('.') + 1)..] : key;
        return string.Concat(part.Select((c, i) => i > 0 && char.IsUpper(c) ? " " + c : c.ToString()))
                     .Replace("_", " ");
    }
}
