@page "/delivery-partners"
@rendermode InteractiveServer
@attribute [Authorize]
@inject AdminApiClient Api

<PageTitle>Delivery Partners – FoodFleet Admin</PageTitle>

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold text-slate-800">Delivery Partners</h1>
        <p class="text-sm text-slate-500 mt-0.5">Manage riders and their assignments</p>
    </div>
    <button @onclick="OpenCreate"
            class="flex items-center gap-2 rounded-lg bg-brand hover:bg-brand-dark text-white px-4 py-2.5 text-sm font-semibold transition-colors">
        <i class="fa-solid fa-plus"></i> New Partner
    </button>
</div>

@* ── Filter ── *@
<div class="mb-5 max-w-xs">
    <select class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand"
            @onchange="OnBranchChanged">
        <option value="">All Branches</option>
        @foreach (var b in _branches)
        {
            <option value="@b.Id">@b.Name</option>
        }
    </select>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="mb-4 rounded-xl bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700 flex items-center gap-2">
        <i class="fa-solid fa-circle-exclamation"></i> @_error
    </div>
}
@if (!string.IsNullOrEmpty(_success))
{
    <div class="mb-4 rounded-xl bg-emerald-50 border border-emerald-200 px-4 py-3 text-sm text-emerald-700 flex items-center gap-2">
        <i class="fa-solid fa-circle-check"></i> @_success
    </div>
}

@if (_loading)
{
    <div class="flex justify-center py-16">
        <div class="flex flex-col items-center gap-3 text-slate-400">
            <i class="fa-solid fa-circle-notch fa-spin fa-2x"></i>
            <span class="text-sm">Loading partners...</span>
        </div>
    </div>
}
else
{
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <table class="w-full text-sm">
            <thead class="bg-slate-50 border-b border-slate-200">
                <tr>
                    <th class="px-5 py-3.5 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Partner</th>
                    <th class="px-5 py-3.5 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Phone</th>
                    <th class="px-5 py-3.5 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Vehicle</th>
                    <th class="px-5 py-3.5 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Branch</th>
                    <th class="px-5 py-3.5 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Available</th>
                    <th class="px-5 py-3.5 text-center text-xs font-semibold uppercase tracking-wider text-slate-500">Orders Done</th>
                    <th class="px-5 py-3.5 text-center text-xs font-semibold uppercase tracking-wider text-slate-500">Rating</th>
                    <th class="px-5 py-3.5"></th>
                </tr>
            </thead>
            <tbody>
                @if (_partners.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="px-5 py-12 text-center text-slate-400">
                            <i class="fa-solid fa-motorcycle text-3xl mb-2 block"></i>
                            No delivery partners found.
                        </td>
                    </tr>
                }
                @foreach (var p in _partners)
                {
                    <tr class="border-t border-slate-100 hover:bg-slate-50/50 transition-colors">
                        <td class="px-5 py-3.5">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-brand/10 flex items-center justify-center text-brand text-sm font-bold shrink-0">
                                    @p.Name[0]
                                </div>
                                <span class="font-medium text-slate-800">@p.Name</span>
                            </div>
                        </td>
                        <td class="px-5 py-3.5 text-slate-600">@p.PhoneNumber</td>
                        <td class="px-5 py-3.5">
                            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-slate-100 text-slate-600">
                                @p.VehicleType
                            </span>
                        </td>
                        <td class="px-5 py-3.5 text-slate-600">@p.BranchName</td>
                        <td class="px-5 py-3.5">
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" class="sr-only peer" checked="@p.IsAvailable"
                                       @onchange="e => ToggleAvailability(p, e)" />
                                <div class="w-10 h-5 bg-slate-200 peer-checked:bg-emerald-500 rounded-full transition-colors
                                            after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4
                                            after:bg-white after:rounded-full after:transition-transform
                                            peer-checked:after:translate-x-5"></div>
                            </label>
                        </td>
                        <td class="px-5 py-3.5 text-center font-semibold text-slate-700">@p.TotalOrdersCompleted</td>
                        <td class="px-5 py-3.5 text-center">
                            @if (p.AverageRating.HasValue)
                            {
                                <span class="inline-flex items-center gap-1 text-amber-600 font-semibold">
                                    <i class="fa-solid fa-star text-amber-400 text-xs"></i>
                                    @p.AverageRating.Value.ToString("0.1")
                                </span>
                            }
                            else
                            {
                                <span class="text-slate-400">—</span>
                            }
                        </td>
                        <td class="px-5 py-3.5 text-right">
                            <button @onclick="() => OpenEdit(p)"
                                    class="rounded-lg border border-slate-300 hover:bg-slate-50 text-slate-600 px-3 py-1.5 text-xs font-medium transition-colors">
                                <i class="fa-solid fa-pen-to-square mr-1"></i>Edit
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_showModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md mx-4">
            <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
                <h2 class="text-lg font-semibold text-slate-800">@(_editId == null ? "New Delivery Partner" : "Edit Partner")</h2>
                <button @onclick="() => _showModal = false"
                        class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-slate-100 text-slate-400 hover:text-slate-600 transition-colors">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="px-6 py-5 space-y-4">
                @if (!string.IsNullOrEmpty(_modalError))
                {
                    <div class="rounded-xl bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">@_modalError</div>
                }
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Full Name *</label>
                        <input class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand"
                               @bind="_form.Name" placeholder="Partner name" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Phone *</label>
                        <input class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand"
                               @bind="_form.PhoneNumber" />
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Email</label>
                    <input class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand"
                           type="email" @bind="_form.Email" placeholder="optional" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Vehicle Type</label>
                    <select class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand"
                            @bind="_form.VehicleType">
                        <option>Bicycle</option>
                        <option>Motorcycle</option>
                        <option>Car</option>
                        <option>Scooter</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Branch *</label>
                    <select class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand"
                            @bind="_form.BranchId">
                        <option value="">— Select Branch —</option>
                        @foreach (var b in _branches)
                        {
                            <option value="@b.Id">@b.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-slate-100 bg-slate-50 rounded-b-2xl">
                <button @onclick="() => _showModal = false"
                        class="rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 py-2 text-sm font-semibold transition-colors">
                    Cancel
                </button>
                <button @onclick="SavePartner" disabled="@_saving"
                        class="flex items-center gap-2 rounded-lg bg-brand hover:bg-brand-dark text-white px-4 py-2 text-sm font-semibold transition-colors disabled:opacity-60">
                    @if (_saving) { <i class="fa-solid fa-circle-notch fa-spin"></i> }
                    Save
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<BranchDto> _branches = new();
    private List<DeliveryPartnerDto> _partners = new();
    private bool _loading = true;
    private string _error = string.Empty;
    private string _success = string.Empty;
    private Guid? _filterBranchId;

    private bool _showModal;
    private bool _saving;
    private string _modalError = string.Empty;
    private Guid? _editId;
    private PartnerFormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        var r = await Api.GetBranchesAsync();
        if (r.IsSuccess) _branches = r.Data ?? new();
        await LoadPartners();
    }

    private async Task OnBranchChanged(ChangeEventArgs e)
    {
        _filterBranchId = Guid.TryParse(e.Value?.ToString(), out var bid) ? bid : null;
        await LoadPartners();
    }

    private async Task LoadPartners()
    {
        _loading = true; _error = string.Empty;
        var r = await Api.GetDeliveryPartnersAsync(_filterBranchId);
        if (r.IsSuccess) _partners = r.Data ?? new();
        else _error = r.Error ?? "Failed to load delivery partners.";
        _loading = false;
    }

    private void OpenCreate()
    {
        _editId = null;
        _form = new();
        _modalError = string.Empty;
        _showModal = true;
    }

    private void OpenEdit(DeliveryPartnerDto p)
    {
        _editId = p.Id;
        _form = new PartnerFormModel
        {
            Name = p.Name, PhoneNumber = p.PhoneNumber,
            Email = p.Email ?? string.Empty, VehicleType = p.VehicleType,
            BranchId = p.BranchId.ToString()
        };
        _modalError = string.Empty;
        _showModal = true;
    }

    private async Task SavePartner()
    {
        if (string.IsNullOrWhiteSpace(_form.Name) || string.IsNullOrWhiteSpace(_form.PhoneNumber))
        {
            _modalError = "Name and phone are required."; return;
        }
        if (!Guid.TryParse(_form.BranchId, out var branchId))
        {
            _modalError = "Please select a branch."; return;
        }
        _saving = true; _modalError = string.Empty;

        var r = await Api.CreateDeliveryPartnerAsync(new CreateDeliveryPartnerRequest(
            branchId, _form.Name, _form.PhoneNumber, _form.Email, _form.VehicleType));

        _saving = false;
        if (r.IsSuccess) { _showModal = false; _success = "Partner saved."; await LoadPartners(); }
        else _modalError = r.Error ?? "Save failed.";
    }

    private async Task ToggleAvailability(DeliveryPartnerDto p, ChangeEventArgs e)
    {
        var available = (bool)(e.Value ?? false);
        var r = await Api.ToggleDeliveryPartnerAvailabilityAsync(p.Id, available);
        if (r.IsSuccess) { p.IsAvailable = available; _success = $"{p.Name} availability updated."; }
        else _error = r.Error ?? "Failed.";
    }

    private class PartnerFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string VehicleType { get; set; } = "Motorcycle";
        public string BranchId { get; set; } = string.Empty;
    }
}
