@page "/dashboard"
@attribute [Authorize]
@inject AdminApiClient Api

<PageTitle>Dashboard – FoodFleet Admin</PageTitle>

<!-- Page header -->
<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-xl font-bold text-slate-800">Dashboard</h1>
        <p class="text-sm text-slate-500 mt-0.5">Welcome back! Here's what's happening today.</p>
    </div>
    <span class="text-xs text-slate-400 bg-white border border-slate-200 px-3 py-1.5 rounded-lg shadow-sm">
        <i class="fa-regular fa-calendar mr-1.5"></i>@DateTime.Now.ToString("MMMM d, yyyy")
    </span>
</div>

@if (_loading)
{
    <div class="flex items-center justify-center h-64">
        <div class="flex flex-col items-center gap-3">
            <svg class="animate-spin h-8 w-8 text-brand" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            <span class="text-sm text-slate-500">Loading dashboard...</span>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(_error))
{
    <div class="flex items-center gap-2.5 bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-xl">
        <i class="fa-solid fa-circle-exclamation"></i><span>@_error</span>
    </div>
}
else if (_data is not null)
{
    <!-- Stat Cards -->
    <div class="grid grid-cols-2 xl:grid-cols-6 gap-4 mb-6">
        <!-- Today's Orders -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 flex flex-col gap-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Today's Orders</span>
                <div class="w-8 h-8 bg-blue-50 rounded-xl flex items-center justify-center">
                    <i class="fa-solid fa-bag-shopping text-blue-500 text-sm"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-slate-800">@_data.TodaysOrders</p>
        </div>

        <!-- Today's Revenue -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 flex flex-col gap-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Today's Revenue</span>
                <div class="w-8 h-8 bg-emerald-50 rounded-xl flex items-center justify-center">
                    <i class="fa-solid fa-indian-rupee-sign text-emerald-500 text-sm"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-slate-800">₹@_data.TodaysRevenue.ToString("N0")</p>
        </div>

        <!-- Pending Orders -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 flex flex-col gap-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Pending</span>
                <div class="w-8 h-8 bg-amber-50 rounded-xl flex items-center justify-center">
                    <i class="fa-solid fa-clock text-amber-500 text-sm"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-slate-800">@_data.PendingOrders</p>
        </div>

        <!-- Active Branches -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 flex flex-col gap-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Active Branches</span>
                <div class="w-8 h-8 bg-sky-50 rounded-xl flex items-center justify-center">
                    <i class="fa-solid fa-store text-sky-500 text-sm"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-slate-800">@_data.ActiveBranches</p>
        </div>

        <!-- Low Stock -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 flex flex-col gap-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Low Stock</span>
                <div class="w-8 h-8 bg-red-50 rounded-xl flex items-center justify-center">
                    <i class="fa-solid fa-triangle-exclamation text-red-500 text-sm"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-slate-800">@_data.LowStockItems</p>
        </div>

        <!-- Avg Prep Time -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 flex flex-col gap-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Avg Prep</span>
                <div class="w-8 h-8 bg-violet-50 rounded-xl flex items-center justify-center">
                    <i class="fa-solid fa-stopwatch text-violet-500 text-sm"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-slate-800">@_data.AvgPrepTimeMinutes<span class="text-base font-medium text-slate-400 ml-1">min</span></p>
        </div>
    </div>

    <!-- Tables -->
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-5">
        <!-- Recent Orders -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
            <div class="flex items-center justify-between px-5 py-4 border-b border-slate-100">
                <h2 class="text-sm font-semibold text-slate-700 flex items-center gap-2">
                    <i class="fa-solid fa-receipt text-brand text-xs"></i> Recent Orders
                </h2>
                <a href="/orders" class="text-xs text-brand font-medium hover:underline">View all</a>
            </div>
            @if (_data.RecentOrders.Count == 0)
            {
                <div class="flex flex-col items-center justify-center py-12 text-slate-400">
                    <i class="fa-solid fa-receipt text-3xl mb-2"></i>
                    <p class="text-sm">No recent orders</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="bg-slate-50">
                                <th class="text-left text-xs font-semibold text-slate-500 uppercase tracking-wide px-5 py-3">Order #</th>
                                <th class="text-left text-xs font-semibold text-slate-500 uppercase tracking-wide px-5 py-3">Branch</th>
                                <th class="text-left text-xs font-semibold text-slate-500 uppercase tracking-wide px-5 py-3">Status</th>
                                <th class="text-right text-xs font-semibold text-slate-500 uppercase tracking-wide px-5 py-3">Amount</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50">
                            @foreach (var o in _data.RecentOrders)
                            {
                                <tr class="hover:bg-slate-50 transition-colors">
                                    <td class="px-5 py-3 font-medium text-slate-700">@o.OrderNumber</td>
                                    <td class="px-5 py-3 text-slate-500">@o.BranchName</td>
                                    <td class="px-5 py-3">
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium @StatusBadgeClass(o.Status)">
                                            @o.Status
                                        </span>
                                    </td>
                                    <td class="px-5 py-3 text-right font-semibold text-slate-700">₹@o.TotalAmount.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Top Menu Items -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
            <div class="flex items-center justify-between px-5 py-4 border-b border-slate-100">
                <h2 class="text-sm font-semibold text-slate-700 flex items-center gap-2">
                    <i class="fa-solid fa-fire-flame-curved text-brand text-xs"></i> Top Menu Items
                </h2>
                <a href="/menu" class="text-xs text-brand font-medium hover:underline">View all</a>
            </div>
            @if (_data.TopMenuItems.Count == 0)
            {
                <div class="flex flex-col items-center justify-center py-12 text-slate-400">
                    <i class="fa-solid fa-bowl-food text-3xl mb-2"></i>
                    <p class="text-sm">No data yet</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="bg-slate-50">
                                <th class="text-left text-xs font-semibold text-slate-500 uppercase tracking-wide px-5 py-3">#</th>
                                <th class="text-left text-xs font-semibold text-slate-500 uppercase tracking-wide px-5 py-3">Item</th>
                                <th class="text-right text-xs font-semibold text-slate-500 uppercase tracking-wide px-5 py-3">Orders</th>
                                <th class="text-right text-xs font-semibold text-slate-500 uppercase tracking-wide px-5 py-3">Revenue</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50">
                            @foreach (var (item, i) in _data.TopMenuItems.Select((x, i) => (x, i + 1)))
                            {
                                <tr class="hover:bg-slate-50 transition-colors">
                                    <td class="px-5 py-3">
                                        <span class="w-6 h-6 rounded-full bg-brand/10 text-brand text-xs font-bold flex items-center justify-center">@i</span>
                                    </td>
                                    <td class="px-5 py-3 font-medium text-slate-700">@item.Name</td>
                                    <td class="px-5 py-3 text-right text-slate-500">@item.OrderCount</td>
                                    <td class="px-5 py-3 text-right font-semibold text-slate-700">₹@item.Revenue.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    private DashboardSummaryDto? _data;
    private bool _loading = true;
    private string _error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetDashboardAsync();
        if (result.IsSuccess)
            _data = result.Data;
        else
            _error = result.Error ?? "Failed to load dashboard.";
        _loading = false;
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        "Delivered"      => "bg-emerald-100 text-emerald-700",
        "Cancelled"      => "bg-red-100 text-red-700",
        "OutForDelivery" => "bg-sky-100 text-sky-700",
        "Preparing"      => "bg-amber-100 text-amber-700",
        _                => "bg-slate-100 text-slate-600"
    };
}
